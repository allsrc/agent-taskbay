{
  "name": "a2a-agent-workflow-ui",
  "version": "0.1.0",
  "description": "A human-in-the-loop console for Agent2Agent (A2A) workflows. Discover an org's registered A2A agents, start tasks, respond to input-required and auth-required steps, and track task execution in real time with full multi-modal message and artifact rendering (text, Markdown, JSON, files, images, audio, video, PDF).",
  "homepage": "https://github.com/shashikanth-gs/a2a-agent-workflow-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashikanth-gs/a2a-agent-workflow-ui.git"
  },
  "bugs": {
    "url": "https://github.com/shashikanth-gs/a2a-agent-workflow-ui/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "a2a",
    "agent2agent",
    "a2a-protocol",
    "human-in-the-loop",
    "agent-workflow",
    "task-inbox",
    "generative-ui"
  ],
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@bufbuild/protobuf": "^2.13.0",
    "@grpc/grpc-js": "^1.14.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^13.4.6",
    "next": "16.3.6",
    "next-themes": "^0.4.4",
    "postcss": "^8.5.24",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4.0.9",
    "tw-animate-css": "^1.2.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
