\pard\pardeftab720\sa321\partightenfactor0

\f1\b\fs48 \cf0 \strokec2 Why does A2A need Task at all?\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b0\fs24 \cf0 Because agents increasingly do things rather than merely say things.\
For example:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 "Book me a flight"\
\pard\pardeftab720\sa240\partightenfactor0

\f0\fs24 \cf0 potentially involves:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 search\
 
\f3 \uc0\u8595 
\f2 \
select\
 
\f3 \uc0\u8595 
\f2 \
ask user approval\
 
\f3 \uc0\u8595 
\f2 \
authenticate\
 
\f3 \uc0\u8595 
\f2 \
payment\
 
\f3 \uc0\u8595 
\f2 \
ticket issuance\
 
\f3 \uc0\u8595 
\f2 \
return ticket\
\pard\pardeftab720\sa240\partightenfactor0

\f0\fs24 \cf0 That's not naturally modeled as:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 prompt 
\f3 \uc0\u8594 
\f2  completion\
\pard\pardeftab720\sa240\partightenfactor0

\f0\fs24 \cf0 It is much better modeled as:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 Task: Book Flight\
\
SUBMITTED\
   
\f3 \uc0\u8595 
\f2 \
WORKING\
   
\f3 \uc0\u8595 
\f2 \
INPUT_REQUIRED\
"Choose option A or B"\
   
\f3 \uc0\u8595 
\f2 \
WORKING\
   
\f3 \uc0\u8595 
\f2 \
AUTH_REQUIRED\
"Authenticate with airline"\
   
\f3 \uc0\u8595 
\f2 \
WORKING\
   
\f3 \uc0\u8595 
\f2 \
COMPLETED\
\
Artifacts:\
  ticket.pdf\
  booking.json\
\pard\pardeftab720\sa240\partightenfactor0

\f0\fs24 \cf0 Now you can see why 
\f2\fs26 Task
\f0\fs24  exists.\
\pard\pardeftab720\partightenfactor0
