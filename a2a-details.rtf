\f2\fs26 \cf0 Base A2A semantics\
       +\
optional negotiated semantics\
\pard\pardeftab720\sa240\partightenfactor0

\f0\fs24 \cf0 rather than putting arbitrary custom properties directly onto standard protocol types.\
\pard\pardeftab720\partightenfactor0
\cf4 \strokec4 \
\pard\pardeftab720\sa321\partightenfactor0

\f1\b\fs48 \cf0 \strokec2 19. 
\f4\fs52 referenceTaskIds
\f1\fs48 \
\pard\pardeftab720\sa240\partightenfactor0

\f0\b0\fs24 \cf0 Example:\
