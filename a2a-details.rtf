\f2\fs26 \cf0 Message\

\f3 \uc0\u9474 
\f2 \

\f3 \uc0\u9500 \u9472 \u9472 
\f2  Part 1: Text\

\f3 \uc0\u9474 
\f2    "Analyze this invoice"\

\f3 \uc0\u9474 
\f2 \

\f3 \uc0\u9500 \u9472 \u9472 
\f2  Part 2: File\

\f3 \uc0\u9474 
\f2    invoice.pdf\

\f3 \uc0\u9474 
\f2 \

\f3 \uc0\u9492 \u9472 \u9472 
\f2  Part 3: Data\
    \{\
       "customerId": "C123"\
    \}\
