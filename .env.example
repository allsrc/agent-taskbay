# Comma-separated Agent Card URLs the catalog seeds itself from. These
# entries aren't removable from the UI (see A2A_DATA_DIR below for agents
# added/removed via the catalog's "Register agent" dialog).
# The registry is a pluggable interface (src/lib/agent-registry.ts) --
# this env-seed-plus-JSON-file list is the v1 backend for it, not the final
# design (see ROADMAP.md Phase 1).
A2A_REGISTERED_AGENTS=

# Where the catalog-management JSON file (agents added/removed via the UI)
# is stored. Defaults to ./.data relative to the working directory.
A2A_DATA_DIR=

# Database profile. PGlite is the zero-install default; PostgreSQL requires
# A2A_DATABASE_URL. Run `npm run db:migrate` before starting a new database.
A2A_DATABASE_PROFILE=pglite

# Directory used by the embedded PGlite database. Defaults to
# ./.data/pglite relative to the application working directory.
A2A_PGLITE_DATA_DIR=

# Required only when A2A_DATABASE_PROFILE=postgresql. Keep credentials in the
# server environment; this value must never be exposed through NEXT_PUBLIC_*.
A2A_DATABASE_URL=

# Extra sideband extension URIs to negotiate, beyond the built-in ones.
A2A_SIDEBAND_EXTENSION_URIS=

# Set to "false" to block outbound requests to private/loopback/link-local
# network targets (SSRF hardening). Left unset/"true" by default so an
# enterprise deployment can reach agents on its own internal network.
A2A_ALLOW_PRIVATE_NETWORKS=true
