# Comma-separated Agent Card URLs the catalog seeds itself from. These
# entries aren't removable from the UI. Managed agents and discovery snapshots
# are stored in the configured database, behind the AgentRegistry interface.
A2A_REGISTERED_AGENTS=

# Legacy registry import directory. If agents.json exists here, its entries
# are imported on first registry access. The file is kept unchanged; repeated
# imports preserve IDs and do not restore removed agents. Defaults to ./.data.
A2A_DATA_DIR=

# Database profile. PGlite is the zero-install default; PostgreSQL requires
# A2A_DATABASE_URL. Run `npm run db:migrate` before starting a new database.
A2A_DATABASE_PROFILE=pglite

# Directory used by the embedded PGlite database. Defaults to
# ./.data/pglite relative to the application working directory.
A2A_PGLITE_DATA_DIR=

# Binary artifact and original-event archive directory. Defaults to
# ./.data/artifacts. Preserve this directory alongside database backups.
# The initial filesystem adapter accepts objects up to 16 MiB.
A2A_ARTIFACT_DATA_DIR=

# Required only when A2A_DATABASE_PROFILE=postgresql. Keep credentials in the
# server environment; this value must never be exposed through NEXT_PUBLIC_*.
A2A_DATABASE_URL=

# Plane A authentication. `next dev` defaults to development identity when unset.
# Production defaults to OIDC and fails closed without the complete config.
# For a trusted LOCAL production-build demo only, set BOTH development and true.
A2A_AUTH_MODE=
A2A_ALLOW_DEVELOPMENT_AUTH=false
# Canonical externally visible HTTPS origin; proxy/Host headers never select it.
A2A_AUTH_ORIGIN=
# Initial OIDC profile uses authorization code + PKCE, RS256/JWKS signatures.
A2A_OIDC_ISSUER=
A2A_OIDC_CLIENT_ID=
A2A_OIDC_CLIENT_SECRET=
# Server-provisioned organization slug. IdP role/org/email claims are not policy.
A2A_AUTH_ORGANIZATION_SLUG=
# Separate 32-byte random server-only key as 64 hex chars for transient JWE flow.
# Share across web replicas. Rotation invalidates pending login attempts.
A2A_AUTH_FLOW_KEY=
# Absolute cookie/session expiry in seconds (60–86400); default eight hours.
A2A_AUTH_SESSION_SECONDS=28800

# Apply pending migrations when the server starts (ADR 0025). Defaults to true for `next dev` with PGlite and for `npx agent-taskbay`,
# and to false otherwise. With several PostgreSQL replicas keep it false and run `npm run db:migrate` once per release.
A2A_AUTO_MIGRATE=

# embedded (default): dispatch and subscriptions share the long-running Next.js Node process.
# external: run `npm run worker:tasks` separately with PostgreSQL.
# Separate processes cannot share one PGlite data directory.
A2A_COMMAND_WORKER_MODE=embedded

# How often (milliseconds, minimum 100) the worker expires overdue approvals, supersedes
# approvals whose task finished, refreshes in-flight approved deliveries and escalates overdue
# owned tasks. Default 15000.
A2A_DECISION_SWEEP_MS=

# Extra sideband extension URIs to negotiate, beyond the built-in ones.
A2A_SIDEBAND_EXTENSION_URIS=

# Exact allowed outbound origins, comma-separated. Required in production.
# Include card/interface origins, separately the OAuth token endpoint origin, and the notification webhook origin.
A2A_ALLOWED_AGENT_ORIGINS=
# Private/loopback access is opt-in in production; metadata/link-local/reserved
# addresses are always blocked. Development allows private targets unless false.
A2A_ALLOW_PRIVATE_NETWORKS=false
# Server-only vault key ring: JSON map of key IDs to 64 hex characters.
# Retain old keys until every binding is re-encrypted with the active key.
A2A_VAULT_KEYS=
A2A_VAULT_ACTIVE_KEY=
# JSON array of exact origin/kid/public jwk (with alg)/ISO expiresAt trust pins.
A2A_TRUSTED_CARD_KEYS=[]
A2A_REQUIRE_SIGNED_CARDS=false

# Optional worker-managed task push. Leave callback origin unset to disable.
# Web and workers need the same externally reachable HTTPS origin and signing
# key. Generate a server-only 32-byte random key as 64 hex characters. Never
# use a NEXT_PUBLIC_* variable. Credentials are derived per registration and
# never stored in database rows or browser state.
A2A_PUSH_CALLBACK_ORIGIN=
A2A_PUSH_SIGNING_KEY=
# Explicit loopback-only HTTP exception for local fixture/development testing.
A2A_PUSH_ALLOW_LOOPBACK_HTTP=false

# Optional external notification channel: a signed JSON webhook (Slack-compatible `text`) that also
# receives each in-app notification for ONE organization. Leave empty for in-app notifications only.
# The URL's origin must also be listed in A2A_ALLOWED_AGENT_ORIGINS, and it may not contain a query string.
A2A_NOTIFY_WEBHOOK_URL=
# Required with the URL, at least 32 characters. Receivers verify X-Agent-Taskbay-Signature (v1=HMAC-SHA256 of "timestamp.body").
A2A_NOTIFY_WEBHOOK_SECRET=
# Organization slug whose notifications are sent (default: local).
A2A_NOTIFY_WEBHOOK_ORGANIZATION=

# Optional AG-UI adapter (ADR 0021): POST /api/agents/{agentId}/ag-ui runs an agent task for AG-UI clients over
# the durable command path. Off unless exactly "true"; when off the route answers 404. Same-origin, authenticated callers only.
A2A_AGUI_ENABLED=false
